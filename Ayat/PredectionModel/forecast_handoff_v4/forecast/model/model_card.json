    "bagging_freq": 1,
    "lambda_l2": 1.0,
    "seed": 42,
    "verbose": -1
  },
  "num_trees": 400,
  "features": [
    "category_id",
    "h",
    "dow",
    "is_weekend",
    "is_holiday",
    "mean_7",
    "mean_30",
    "std_30",
    "same_dow_4w",
    "trend",
    "weekend_ratio"
  ],
  "categorical_feature": "category_id",
  "category_order": [
    "app",
    "cleanliness",
    "hvac",
    "noise",
    "parking",
    "parks",
    "power_outage",
    "roads",
