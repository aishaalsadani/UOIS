    "cleanliness": "waste",
    "hvac": "buildings",
    "noise": "environment",
    "parking": "mobility",
    "parks": "environment",
    "power_outage": "energy",
    "roads": "mobility",
    "safety": "public_safety",
    "sewer": "water",
    "streetlights": "public_safety",
    "traffic_signals": "mobility",
    "waste_overflow": "waste",
    "water_leak": "water",
    "water_outage": "water"
  },
  "window_days": 30,
  "horizon_days": 15,
  "training_cutoffs": [
    "2025-07-30",
    "2025-12-16"
